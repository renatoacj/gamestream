        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="GameStream" Width="1280" Height="900" MinWidth="820" MinHeight="600"
        Background="#0f1115" Icon="Assets/app.ico">
